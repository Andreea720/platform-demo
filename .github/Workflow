name: Platform Demo CI/CD Pipeline

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
      # 1. Check out the repository source code
      - name: Checkout Repository
        uses: actions/checkout@v4

      # 2. Set up Node.js environment (Adjust version if your project uses Python, Java, etc.)
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'

      # 3. Install project dependencies
      - name: Install Dependencies
        run: npm ci

      # 4. Run linter or code quality checks (optional/uncomment if configured)
      # - name: Run Lint
      #   run: npm run lint

      # 5. Run automated tests
      - name: Run Tests
        run: npm test
        continue-on-error: true # Prevents pipeline from failing if tests aren't written yet

      # 6. Build the project
      - name: Build Project
        run: npm run build
        continue-on-error: true
